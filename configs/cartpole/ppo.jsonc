{
  "agent_type": "ppo",
  "env": {
    "id": "CartPole-v1",
    "kwargs": {},
    "num_env": 4,
    "seed": 42,
    "render_every": 150 // moved to env config
  },
  "train": {
    "total_steps": 5000000,
    "learning_rate": 0.0003,
    "gamma": 0.99,
    "lambda": 0.95, // for gae
    "num_steps": 1000, //steps per env executed in one episode
    "lr_steps": 10, // number of steps in learning phase
    "clip_coef": 0.2, // the value of clipping coefficent for policy loss
    "ent_coef": 0.01, // entropy bonus coefficent
    "vf_coef": 0.5,   // coefficent of the value function
    "mb_num": 4,  // number of the minibatches
    "value_loss_coeff": 0.5,
    "entropy_coeff": 0.01,
    "save_every": 100,
    "stats_window": 100,
    "experiments_dir": "experiments"
  },
  "model": {
    "hidden_dim": 128,
    "shared_network": true
  }
}