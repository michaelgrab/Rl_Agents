{
  "agent_type": "ppo",
  "env": {
    "id": "CartPole-v1",
    "kwargs": {},
    "num_env": 4,
    "seed": 42,
    "torch_deterministic": true, // controls `torch.backends.cudnn.deterministic`
    "render_every": 150 // moved to env config
  },
  "train": {
    "total_steps": 500000,
    "learning_rate": 2.5e-4,
    "gamma": 0.99,
    "lambda": 0.95, // for gae
    "num_steps": 128, //steps per env executed in one episode
    "lr_steps": 4, // number of steps in learning phase
    "clip_coef": 0.2, // the value of clipping coefficent for policy loss
    "ent_coef": 0.01, // entropy bonus coefficent
    "vf_coef": 0.5,   // coefficent of the value function
    "mb_num": 4,  // number of the minibatches
    "value_loss_coeff": 0.5,
    "entropy_coeff": 0.01,
    "adv_norm": true, // advantage normalization
    "lr_anneal": true,  // learning rate annealig
    "gradient_clip": 0.5, // max norm for the gradient clipping
    "adam_eps": 1e-5,
    "save_every": 10,
    "stats_window": 100,
    "experiments_dir": "experiments"
  },
  "model": {
    "hidden_dim": 64,
    "shared_network": true,
    "debug_mode": true,
    "record_stats": true
  }
}